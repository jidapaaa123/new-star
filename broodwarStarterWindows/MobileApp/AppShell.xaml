<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MobileApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MobileApp.Pages"
    Title="Starcraft Bot Control">

    <TabBar>
        <ShellContent
            Title="Dashboard"
            ContentTemplate="{DataTemplate local:DashboardPage}"
            Route="dashboard" />

        <ShellContent
            Title="Events"
            ContentTemplate="{DataTemplate local:EventsPage}"
            Route="events" />

        <ShellContent
            Title="History"
            ContentTemplate="{DataTemplate local:HistoryPage}"
            Route="history" />

        <ShellContent
            Title="Analytics"
            ContentTemplate="{DataTemplate local:AnalyticsPage}"
            Route="analytics" />

        <ShellContent 
            Title="Practice" 
            Icon="icon_about.png" 
            Route="practice" 
            ContentTemplate="{DataTemplate local:Practice}" />
    </TabBar>

</Shell>

